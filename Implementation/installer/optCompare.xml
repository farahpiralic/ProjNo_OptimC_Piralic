<?xml version='1.0'?>
<!--
	SetupCollector config for OptimCompare (Project #16, F. Piralic 20106).
	Values already filled in:
	  executableName = optCompare      (OPTCOMPARE_NAME in optCompare.cmake)
	  solution       = optCompareSol   (SOLUTION_NAME in CMakeLists.txt)
	  project folder = OptimCompare     (repo lives at ~/OptimCompare)

	To run: copy this file to ~/Setups/ and run SetupCollector on it,
	or just use make-linux-installer.sh / the GitHub Actions workflow,
	which do that copy for you.
-->
<SetupCollector xmlns:win="windows" xmlns:mac="macOS" xmlns:lin="linux" executableName="optCompare">

	<Folders dev="~OptimCompare"
			 executable="$RAMDisk/Out/optCompareSol/Release"
			 out="$RAMDisk/Setup/optCompare"/>

	<Packages debug="false">
		<!-- covers mainUtils + dataProvider + natGUI -->
		<Package name="natGUIALL"/>

		<!-- OptimCompare links the dense Matrix library (Newton's solve,
		     BFGS, the Hessians) - REQUIRED, natGUIALL does not include it -->
		<Package name="Matrix"/>

		<!-- GTK runtime is bundled into the Windows installer only -->
		<Package name="GTK4" exclude="macOS,linux"/>
	</Packages>

	<ResData>
		<Res type="folder" dev="$MyBin/GTK/release/share/glib-2.0/schemas" dep="schemas" exclude="macOS,linux"/>
	</ResData>

	<MutableResource/>

	<Setup licenseFileName="~natID.SDK/DevEnv/License.txt"
			categories="Education"
			win:programGroup="OptimCompare"
			win:width="440"
			win:headerBackColor="#30D5C8"
			win:headerTxtColor="#1A1A2E"
			win:licenseTxtColor="#846060"
			win:useMakeCabinet="true"
			win:minBuildNumber="17763"
			lin:depends="$DepGTKv4"/>
</SetupCollector>
